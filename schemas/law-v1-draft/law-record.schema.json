{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnlegal:law-json:1.0-draft",
  "title": "VN legal source records (Task4 proposal, not accepted)",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "$ref": "#/$defs/legal_unit"
    },
    {
      "$ref": "#/$defs/guidance"
    },
    {
      "$ref": "#/$defs/footnote"
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "text_sha256",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "needs_review",
            "approved",
            "rejected",
            "quarantined"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "reviewer_id",
        "reviewed_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "temporal": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unresolved",
            "verified"
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end_status": {
          "enum": [
            "unresolved",
            "open",
            "known"
          ]
        },
        "basis_evidence": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "status",
        "effective_from",
        "effective_to",
        "end_status",
        "basis_evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "effective_from": {
                "type": "null"
              },
              "effective_to": {
                "type": "null"
              },
              "end_status": {
                "const": "unresolved"
              },
              "basis_evidence": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "effective_from": {
                "type": "string",
                "format": "date"
              },
              "end_status": {
                "enum": [
                  "open",
                  "known"
                ]
              },
              "basis_evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "end_status": {
                "const": "open"
              }
            }
          },
          "then": {
            "properties": {
              "effective_to": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "end_status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "effective_to": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    },
    "part": {
      "type": "object",
      "properties": {
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "text_path": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_pdf_path": {
          "type": "string",
          "minLength": 1
        },
        "raw_pdf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "part_id",
        "text_path",
        "text_sha256",
        "raw_pdf_path",
        "raw_pdf_sha256",
        "source_url",
        "source_revision"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "ordered_parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          },
          "minItems": 1
        },
        "text_review_status": {
          "enum": [
            "approved",
            "needs_review"
          ]
        },
        "text_approval_record": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "snapshot_id",
        "ordered_parts",
        "text_review_status",
        "text_approval_record"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "law-json-1.0-draft"
        },
        "record_type": {
          "const": "document"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "const": "VN"
        },
        "official_number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "document_kind": {
          "enum": [
            "statute",
            "amendment",
            "implementation_resolution",
            "consolidation"
          ]
        },
        "text_snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "legal_version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "relations_status": {
          "enum": [
            "not_processed",
            "needs_review",
            "approved"
          ]
        },
        "relations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "relation_type": {
                "enum": [
                  "AMENDS",
                  "IMPLEMENTS",
                  "CONSOLIDATES",
                  "REFERS_TO"
                ]
              },
              "target_document_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                },
                "minItems": 1
              },
              "review": {
                "$ref": "#/$defs/review"
              }
            },
            "required": [
              "relation_type",
              "target_document_id",
              "evidence",
              "review"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "rights_status": {
          "enum": [
            "unresolved",
            "verified"
          ]
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "review",
        "document_id",
        "jurisdiction",
        "official_number",
        "title",
        "document_kind",
        "text_snapshot",
        "legal_version_id",
        "temporal",
        "relations_status",
        "relations",
        "rights_status"
      ],
      "additionalProperties": false
    },
    "legal_unit": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "law-json-1.0-draft"
        },
        "record_type": {
          "const": "legal_unit"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "legal_version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "unit_type": {
          "enum": [
            "article",
            "clause",
            "point"
          ]
        },
        "article_number": {
          "type": "string",
          "pattern": "^[0-9]+[a-zđ]?$"
        },
        "clause_number": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$"
        },
        "point_label": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-zđ]$"
        },
        "parent_unit_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "footnote_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "structure_context": {
          "type": "object",
          "properties": {
            "part": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/$defs/evidence"
                      }
                    }
                  },
                  "required": [
                    "label",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "chapter": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/$defs/evidence"
                      }
                    }
                  },
                  "required": [
                    "label",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "section": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/$defs/evidence"
                      }
                    }
                  },
                  "required": [
                    "label",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "part",
            "chapter",
            "section"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "review",
        "unit_id",
        "document_id",
        "snapshot_id",
        "legal_version_id",
        "unit_type",
        "article_number",
        "clause_number",
        "point_label",
        "parent_unit_id",
        "title",
        "text",
        "evidence",
        "footnote_refs",
        "temporal",
        "structure_context"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "unit_type": {
                "const": "article"
              }
            }
          },
          "then": {
            "properties": {
              "clause_number": {
                "type": "null"
              },
              "point_label": {
                "type": "null"
              },
              "parent_unit_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit_type": {
                "const": "clause"
              }
            }
          },
          "then": {
            "properties": {
              "clause_number": {
                "type": "string"
              },
              "point_label": {
                "type": "null"
              },
              "parent_unit_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit_type": {
                "const": "point"
              }
            }
          },
          "then": {
            "properties": {
              "clause_number": {
                "type": "string"
              },
              "point_label": {
                "type": "string"
              },
              "parent_unit_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "guidance": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "law-json-1.0-draft"
        },
        "record_type": {
          "const": "guidance"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "guidance_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "source_role": {
          "enum": [
            "amending_instructions",
            "implementation_resolution"
          ]
        },
        "content_scope": {
          "const": "whole_document"
        },
        "target_mapping_status": {
          "enum": [
            "unresolved",
            "reviewed"
          ]
        },
        "target_unit_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "review",
        "guidance_id",
        "document_id",
        "snapshot_id",
        "source_role",
        "content_scope",
        "target_mapping_status",
        "target_unit_ids",
        "text",
        "evidence",
        "temporal"
      ],
      "additionalProperties": false
    },
    "footnote": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "law-json-1.0-draft"
        },
        "record_type": {
          "const": "footnote"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "footnote_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "review",
        "footnote_id",
        "document_id",
        "snapshot_id",
        "part_id",
        "label",
        "text",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
