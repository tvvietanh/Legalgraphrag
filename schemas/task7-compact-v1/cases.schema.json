      "type": "string",
      "minLength": 1
    },
    "document_number": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "decision_text": {
      "type": "string",
